local function logKey() end

local function keyWindow()
    local KG = Instance.new("ScreenGui"); KG.Name = "LiftHub_Key"; KG.ResetOnSpawn = false; KG.ZIndexBehavior = Enum.ZIndexBehavior.Sibling; KG.IgnoreGuiInset = true
    local KCG = game:GetService("CoreGui")
    local KLP = game:GetService("Players").LocalPlayer
    local KPG = KLP:FindFirstChild("PlayerGui") or KLP:WaitForChild("PlayerGui")
    local KUIS = game:GetService("UserInputService")
    local KTW = game:GetService("TweenService")
    local kp = nil
    pcall(function() if gethui then kp = gethui() end end)
    if not kp then kp = KPG end
    KG.Parent = kp
    local KF = Instance.new("Frame"); KF.Size = UDim2.new(0,360,0,252); KF.Position = UDim2.new(0.5,-180,0.5,-126); KF.BackgroundColor3 = Color3.fromRGB(20,20,26); KF.BorderSizePixel = 0; KF.Parent = KG
    local KC = Instance.new("UICorner"); KC.CornerRadius = UDim.new(0,12); KC.Parent = KF
    local KS = Instance.new("UIStroke"); KS.Color = Color3.fromRGB(0,122,255); KS.Thickness = 1.5; KS.Parent = KF
    local KGrad = Instance.new("UIGradient"); KGrad.Rotation = 90; KGrad.Color = ColorSequence.new{ColorSequenceKeypoint.new(0, Color3.fromRGB(30,30,40)), ColorSequenceKeypoint.new(1, Color3.fromRGB(14,14,20))}; KGrad.Parent = KF
    local KPop = Instance.new("UIScale"); KPop.Scale = 0.7; KPop.Parent = KF; KTW:Create(KPop,TweenInfo.new(0.3,Enum.EasingStyle.Back,Enum.EasingDirection.Out),{Scale=1}):Play()
    local KT = Instance.new("TextLabel"); KT.Size = UDim2.new(1,0,0,44); KT.BackgroundTransparency = 1; KT.Text = "KEY SYSTEM"; KT.TextColor3 = Color3.fromRGB(255,255,255); KT.TextSize = 16; KT.Font = Enum.Font.GothamBold; KT.Parent = KF
    local KSub = Instance.new("TextLabel"); KSub.Size = UDim2.new(1,0,0,16); KSub.Position = UDim2.new(0,0,0,40); KSub.BackgroundTransparency = 1; KSub.Text = "Enter key to continue"; KSub.TextColor3 = Color3.fromRGB(140,140,150); KSub.TextSize = 11; KSub.Font = Enum.Font.Gotham; KSub.Parent = KF
    local KBox = Instance.new("TextBox"); KBox.Size = UDim2.new(1,-24,0,34); KBox.Position = UDim2.new(0,12,0,64); KBox.BackgroundColor3 = Color3.fromRGB(30,30,38); KBox.Text = ""; KBox.PlaceholderText = "Enter key..."; KBox.TextColor3 = Color3.fromRGB(255,255,255); KBox.PlaceholderColor3 = Color3.fromRGB(120,120,130); KBox.TextSize = 12; KBox.Font = Enum.Font.Gotham; KBox.ClearTextOnFocus = false; KBox.Parent = KF
    local KBC = Instance.new("UICorner"); KBC.CornerRadius = UDim.new(0,8); KBC.Parent = KBox
    local Check = Instance.new("TextButton"); Check.Size = UDim2.new(1,-24,0,40); Check.Position = UDim2.new(0,12,0,110); Check.BackgroundColor3 = Color3.fromRGB(0,170,90); Check.Text = "CHECK KEY"; Check.TextColor3 = Color3.fromRGB(255,255,255); Check.Font = Enum.Font.GothamBold; Check.TextSize = 14; Check.AutoButtonColor = false; Check.Parent = KF
    local CC = Instance.new("UICorner"); CC.CornerRadius = UDim.new(0,8); CC.Parent = Check

    local function good()
        pcall(function() if delfile and isfile and isfile(KEY_FILE) then delfile(KEY_FILE) end end)
        logKey()
        notify("Key", "Correct! Opening Hub...", 2)
        KG:Destroy()
        openHub()
    end
    Check.MouseButton1Click:Connect(function()
        if keyOK(KBox.Text) then good() else notify("Key", "Wrong key!", 3) end
    end)
    KBox.FocusLost:Connect(function(enter) if enter then if keyOK(KBox.Text) then good() else notify("Key", "Wrong key!", 3) end end end)
    KUIS.InputBegan:Connect(function(input)
        if not alive() then return end
        if input.KeyCode == Enum.KeyCode.Escape then KG:Destroy() end
    end)
end
keyWindow()
